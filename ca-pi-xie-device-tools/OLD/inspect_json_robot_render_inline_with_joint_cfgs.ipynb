    "    min_depth_m=MIN_DEPTH_M, max_depth_m=MAX_DEPTH_M, point_max=POINT_MAX,\n",
    "    apply_o3d=APPLY_O3D_TO_POINT_CLOUD\n",
    ")\n",
    "\n",
    "print('camera_timestamp      =', CAMERA_TIMESTAMP)\n",
