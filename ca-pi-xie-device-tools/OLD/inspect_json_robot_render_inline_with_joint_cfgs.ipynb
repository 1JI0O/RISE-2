    "intrinsic, intrinsic_key = load_intrinsic(INTRINSICS_NPY, INTRINSIC_KEY)\n",
    "\n",
    "idx, matched_ts, left_joint_h5, right_joint_h5, left_tcp, right_tcp = extract_joint_and_gripper(\n",
