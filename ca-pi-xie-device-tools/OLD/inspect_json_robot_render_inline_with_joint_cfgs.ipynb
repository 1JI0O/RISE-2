    ")\n",
    "\n",
    "left_cfg = load_robot_joint_cfgs(AIREXO2_JOINT_CFG_ROOT, 'left', use_old=USE_ROBOT_OLD_CFG)\n",
    "right_cfg = load_robot_joint_cfgs(AIREXO2_JOINT_CFG_ROOT, 'right', use_old=USE_ROBOT_OLD_CFG)\n",
    "\n",
    "left_joint_init = init_joint_deg_to_joint(LEFT_INIT_JOINT_DEG, INIT_GRIPPER_WIDTH)\n",
    "right_joint_init = init_joint_deg_to_joint(RIGHT_INIT_JOINT_DEG, INIT_GRIPPER_WIDTH)\n",
    "left_joint_init_cfg = init_joint_deg_to_joint_with_cfg(LEFT_INIT_JOINT_DEG, INIT_GRIPPER_WIDTH, left_cfg)\n",
    "right_joint_init_cfg = init_joint_deg_to_joint_with_cfg(RIGHT_INIT_JOINT_DEG, INIT_GRIPPER_WIDTH, right_cfg)\n",
    "\n",
    "left_joint_official = np.asarray(OFFICIAL_LEFT_JOINT, dtype=np.float64)\n",
    "right_joint_official = np.asarray(OFFICIAL_RIGHT_JOINT, dtype=np.float64)\n",
    "\n",
    "if JOINT_SOURCE_MODE == 'teleop_init':\n",
    "    if APPLY_JOINT_CFG_TRANSFORM:\n",
    "        left_joint = left_joint_init_cfg.copy()\n",
    "        right_joint = right_joint_init_cfg.copy()\n",
    "    else:\n",
    "        left_joint = left_joint_init.copy()\n",
    "        right_joint = right_joint_init.copy()\n",
