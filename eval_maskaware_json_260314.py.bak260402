def _load_test_color_depth(color_path, depth_path):
    color = np.asarray(Image.open(color_path).convert("RGB"), dtype = np.uint8)
    depth = np.asarray(Image.open(depth_path), dtype = np.float32)
    return color, depth


def _load_test_lowdim(lowdim_path):
    data = np.load(lowdim_path, allow_pickle = True)
    if isinstance(data, np.ndarray) and data.shape == ():
        data = data.item()
    if not isinstance(data, dict):
        raise TypeError("test_low_dim must be a dict-like npy file")
    return data


