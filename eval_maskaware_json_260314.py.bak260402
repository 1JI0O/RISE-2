def _build_mask_aware_cfg(config):
    # 统一推理期 mask-aware 配置并补齐默认值
    default_json_mask_cfg = {
        "left_json": None,
        "right_json": None,
        "cam_base_mode": "base_to_cam__predef",
        "use_agent_intrinsics": True,
        "intrinsics_npy": None,
        "intrinsic_selector": "first",
        "left_urdf": os.path.join("airexo", "airexo", "urdf_models", "robot", "left_robot_inhand.urdf"),
        "right_urdf": os.path.join("airexo", "airexo", "urdf_models", "robot", "right_robot_inhand.urdf"),
        "width": 1280,
        "height": 720,
        "near_plane": 0.01,
        "far_plane": 100.0,
    }

    default_cfg = {
        "enabled": False,
        "enable_3d_filter": True,
        "enable_2d_reweight": True,
        "mask_threshold": 0,
        "mask_white_is_untrusted": True,
        "r_min": 1e-3,
        "interp_eps": 1e-6,
        "interp_tiny": 1e-6,
        "infer_allow_none": True,
        "infer_none_policy": "no_mask_fallback",
        "empty_cloud_policy": "warn_and_skip_filter",
        "urdf": None,
        "json_mask": default_json_mask_cfg,
    }
    raw_cfg = getattr(config, "mask_aware", {})
    raw_cfg = dict(raw_cfg) if raw_cfg is not None else {}

    merged_cfg = deepcopy(default_cfg)
    for key in default_cfg:
        if key not in raw_cfg or raw_cfg[key] is None:
            continue
        if key == "json_mask":
            if isinstance(raw_cfg[key], dict):
                json_cfg = deepcopy(default_json_mask_cfg)
                for json_key, json_val in raw_cfg[key].items():
                    if json_val is not None:
                        json_cfg[json_key] = json_val
                merged_cfg[key] = json_cfg
        else:
            merged_cfg[key] = raw_cfg[key]

    valid_none_policy = {"no_mask_fallback", "fail_fast"}
    valid_empty_cloud_policy = {"warn_and_skip_filter", "fail_fast"}
    valid_cam_base_mode = {
        "base_to_cam__predef",
        "base_to_cam__raw",
        "cam_to_base__predef",
        "cam_to_base__raw",
    }

    try:
        merged_cfg["enabled"] = bool(merged_cfg["enabled"])
        merged_cfg["enable_3d_filter"] = bool(merged_cfg["enable_3d_filter"])
        merged_cfg["enable_2d_reweight"] = bool(merged_cfg["enable_2d_reweight"])
        merged_cfg["mask_threshold"] = float(merged_cfg["mask_threshold"])
        merged_cfg["mask_white_is_untrusted"] = bool(merged_cfg["mask_white_is_untrusted"])
        merged_cfg["r_min"] = float(merged_cfg["r_min"])
        merged_cfg["interp_eps"] = float(merged_cfg["interp_eps"])
        merged_cfg["interp_tiny"] = float(merged_cfg["interp_tiny"])
        merged_cfg["infer_allow_none"] = bool(merged_cfg["infer_allow_none"])
        merged_cfg["infer_none_policy"] = str(merged_cfg["infer_none_policy"])
        merged_cfg["empty_cloud_policy"] = str(merged_cfg["empty_cloud_policy"])

        json_cfg = deepcopy(default_json_mask_cfg)
        if isinstance(merged_cfg.get("json_mask", {}), dict):
            for k, v in merged_cfg["json_mask"].items():
                if v is not None:
                    json_cfg[k] = v

        json_cfg["left_json"] = None if json_cfg["left_json"] is None else str(json_cfg["left_json"])
        json_cfg["right_json"] = None if json_cfg["right_json"] is None else str(json_cfg["right_json"])
        json_cfg["cam_base_mode"] = str(json_cfg["cam_base_mode"])
        json_cfg["use_agent_intrinsics"] = bool(json_cfg["use_agent_intrinsics"])
        json_cfg["intrinsics_npy"] = None if json_cfg["intrinsics_npy"] is None else str(json_cfg["intrinsics_npy"])
        json_cfg["intrinsic_selector"] = str(json_cfg["intrinsic_selector"])
        json_cfg["left_urdf"] = str(json_cfg["left_urdf"])
        json_cfg["right_urdf"] = str(json_cfg["right_urdf"])
        json_cfg["width"] = int(json_cfg["width"])
        json_cfg["height"] = int(json_cfg["height"])
        json_cfg["near_plane"] = float(json_cfg["near_plane"])
        json_cfg["far_plane"] = float(json_cfg["far_plane"])

        if json_cfg["cam_base_mode"] not in valid_cam_base_mode:
            print("[mask-aware/json] invalid cam_base_mode, use base_to_cam__predef")
            json_cfg["cam_base_mode"] = "base_to_cam__predef"

        if (not json_cfg["use_agent_intrinsics"]) and (json_cfg["intrinsics_npy"] is None):
            print("[mask-aware/json] intrinsics_npy is None while use_agent_intrinsics=False, fallback to agent intrinsics")
            json_cfg["use_agent_intrinsics"] = True

        merged_cfg["json_mask"] = edict(json_cfg)
    except Exception as exc:
        print(f"[mask-aware] invalid config, fallback to disabled: {exc}")
        merged_cfg = deepcopy(default_cfg)
        merged_cfg["json_mask"] = edict(deepcopy(default_json_mask_cfg))

    if merged_cfg["infer_none_policy"] not in valid_none_policy:
        print("[mask-aware] invalid infer_none_policy, use no_mask_fallback")
        merged_cfg["infer_none_policy"] = "no_mask_fallback"

    if merged_cfg["empty_cloud_policy"] not in valid_empty_cloud_policy:
        print("[mask-aware] invalid empty_cloud_policy, use warn_and_skip_filter")
        merged_cfg["empty_cloud_policy"] = "warn_and_skip_filter"

    return edict(merged_cfg)


def _log_mask_aware_summary(mask_cfg):
    # 启动时打印一次配置摘要用于排查
    print(
        "[mask-aware] enabled={} 3d_filter={} 2d_reweight={} threshold={} "
        "none_policy={} empty_cloud_policy={}".format(
            mask_cfg.enabled,
            mask_cfg.enable_3d_filter,
            mask_cfg.enable_2d_reweight,
            mask_cfg.mask_threshold,
            mask_cfg.infer_none_policy,
            mask_cfg.empty_cloud_policy,
        )
    )


def _log_mask_fallback(step, reason, action):
    # 异常回退统一日志输出
    print(f"[mask-aware] step={step} reason={reason} action={action}")


